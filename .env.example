# 复制为 .env 后填写：cp .env.example .env && chmod 600 .env
# .env 已在 .gitignore，不会提交；同名进程环境变量优先于此文件。
# 修改后需完整重启 bot（/restart），/reload 不会重读。
# 列表类配置用英文逗号分隔，例如 ADMIN_QQ=10001,10002

# —— LLM（DeepSeek 官方 / OpenAI 兼容接口）——
LLM_API_KEY=
# 网页搜索 Key：不写时，聊天走 DeepSeek 官方地址则复用 LLM_API_KEY；
# 取消下一行注释并留空即可关闭搜索，或填单独的 DeepSeek 官方 Key。
# DEEPSEEK_SEARCH_API_KEY=

# —— OneBot / NapCat（QQ）——
NAPCAT_TOKEN=

# —— 飞书 / Lark ——
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# —— 账号 / 身份 ——
# 主人昵称，会写进人设提示词
MASTER_NAME=
# QQ 号、群号都按字符串处理
MASTER_QQ=
BOT_QQ=
ADMIN_QQ=
# 飞书 open_id（私聊 bot 后看日志 [私聊] (ou_xxx)）
MASTER_FEISHU=
ADMIN_FEISHU=

# —— 群聊潜水白名单（群号，逗号分隔；空 = 不潜水）——
AMBIENT_GROUPS=
